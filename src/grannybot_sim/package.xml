<?xml version="1.0"?>
<package format="3">
  <name>grannybot_sim</name>
  <version>0.1.0</version>
  <description>2D simulator (fake house, person, robot, Nav2, camera) for end-to-end tests without the robot [everyone]</description>
  <maintainer email="team@example.com">GrannyBot team</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>grannybot_vision</exec_depend>
  <exec_depend>grannybot_brain</exec_depend>
  <exec_depend>grannybot_navigation</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
