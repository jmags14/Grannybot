# Copy to .env and fill in. NEVER commit .env.
PERSON_NAME=Grandma

# --- Channel 1: EMAIL (free forever). Use a team Gmail account. ---
# Turn on 2-Step Verification, then Google Account > Security > App passwords > create one.
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_TO=you@example.com

# --- Channel 2: PHONE CALL (Twilio free trial: 75 min, expires 30 days after sign-up,
#     no credit card). Sign up in week 3 so the trial covers final testing + the demo. ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
# Called in order until someone answers. Trial: max 5 verified numbers.
CAREGIVER_PHONES=+1XXXXXXXXXX
CALL_ROUNDS=2
SEND_SMS=false
